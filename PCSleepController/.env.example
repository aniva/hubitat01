# PC Sleep and Wake Controller - Environment Configuration Example
# Copy this file to .env and fill in your private network parameters.
# The .env file is strictly gitignored to keep public repos sanitized.

# --- Target 1: Linux Server (e.g. ai-box) ---
AI_BOX_ENABLED=true
AI_BOX_IP=192.168.1.50
AI_BOX_PORT=8099
AI_BOX_MAC=AA:BB:CC:DD:EE:01
AI_BOX_TOKEN=replace_with_ai_box_secret_token

# --- Target 2: Windows PC (e.g. tv-box) ---
TV_BOX_ENABLED=true
TV_BOX_IP=192.168.1.60
TV_BOX_PORT=8099
TV_BOX_MAC=AA:BB:CC:DD:EE:02
TV_BOX_TOKEN=replace_with_tv_box_secret_token

# --- Optional: PiKVM v2 ATX Pulse Fallback ---
PIKVM_ENABLED=false
PIKVM_IP=192.168.1.70
PIKVM_USER=admin
PIKVM_PASS=replace_with_pikvm_password
